<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Se usa Assert de xUnit a propósito: FluentAssertions 8+ es de pago para uso comercial. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(MsPackageVersion)" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.*" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <!-- <Using Include="GymTracker.Application" /> -->
    <Using Include="GymTracker.Domain" />
    <!--<Using Include="GymTracker.Infrastructure" /> -->
    <Using Include="Dapper" />
    <Using Include="Microsoft.Data.SqlClient" />
    <None Include="..\..\db\init.sql" Link="db\init.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GymTracker.Domain\GymTracker.Domain.csproj" />
    <ProjectReference Include="..\..\src\GymTracker.Application\GymTracker.Application.csproj" />
    <ProjectReference Include="..\..\src\GymTracker.Infrastructure\GymTracker.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\GymTracker.Api\GymTracker.Api.csproj" />
  </ItemGroup>
</Project>